# Copy this file to .env.local and adjust as needed. Never commit .env.local
# (it's gitignored via the *.local pattern).

# Base URL of the backend API (see /backend). Must include the /api prefix.
API_BASE_URL=http://localhost:3000/api

# NOTE: there is deliberately no Gemini API key here. Market analysis calls
# go through the backend's /market proxy (see backend/.env.example) so the
# key never ships to the browser — do not add GEMINI_API_KEY to this file.
