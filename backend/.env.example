# Copy this file to .env and adjust as needed. Never commit the real .env.

NODE_ENV=development
PORT=3000

# Must match docker-compose.yml's postgres service credentials/port.
# Host port 5433 (not 5432) to avoid clashing with any other local Postgres.
DATABASE_URL="postgresql://africrypto:africrypto@localhost:5433/africrypto?schema=public"

# Generate real secrets for anything beyond local dev, e.g.: openssl rand -base64 48
# JWT_SECRET and JWT_REFRESH_SECRET must be different values — a token
# signed for one purpose must never verify against the other's secret.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-only-change-me-too
JWT_REFRESH_EXPIRES_IN=7d

# Optional. Powers GET /market/trend/:cryptoSymbol (AI market commentary).
# Leave blank to disable that endpoint — the rest of the API works fine
# without it. Get a key at https://aistudio.google.com/apikey
# Never put this in the frontend's env — it must only ever live server-side.
GEMINI_API_KEY=
