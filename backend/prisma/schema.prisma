// Prisma schema for AfriCrypto.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType { BUY SELL SEND RECEIVE P2P_BUY P2P_SELL BILL_PAYMENT }
enum TransactionStatus { PENDING PROCESSING COMPLETED FAILED REVERSED }
enum P2PTradeType { BUY SELL }
enum P2PTradeStatus { AWAITING_PAYMENT PAYMENT_MARKED COMPLETED CANCELLED EXPIRED DISPUTED RESOLVED_BUYER RESOLVED_SELLER }

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  username String
  country String
  isVerified Boolean @default(false)
  isAdmin Boolean @default(false)
  p2pRating Float @default(0)
  p2pTrades Int @default(0)
  notificationsEnabled Boolean @default(true)
  profilePicUrl String?
  avatarInitial String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cryptoAssets CryptoAsset[]
  fiatAssets FiatAsset[]
  transactions Transaction[]
  billPayments BillPayment[]
  billWebhookEvents BillWebhookEvent[]
  p2pOffers P2POffer[]
  p2pTradesAsMaker P2PTrade[] @relation("P2PMaker")
  p2pTradesAsTaker P2PTrade[] @relation("P2PTaker")
  refreshTokens RefreshToken[]
  p2pDisputeResolutions P2PDisputeResolution[] @relation("P2PResolver")
  @@map("users")
}

model RefreshToken {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
  @@map("refresh_tokens")
}

model CryptoAsset {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol String
  name String
  balance Decimal @default(0) @db.Decimal(36, 18)
  price Decimal @default(0) @db.Decimal(20, 8)
  changePercent Float @default(0)
  logoChar String
  colorClass String
  updatedAt DateTime @updatedAt
  @@unique([userId, symbol])
  @@map("crypto_assets")
}

model FiatAsset {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  currencyCode String
  symbol String
  balance Decimal @default(0) @db.Decimal(20, 2)
  updatedAt DateTime @updatedAt
  @@unique([userId, currencyCode])
  @@map("fiat_assets")
}

model Transaction {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type TransactionType
  cryptoSymbol String
  cryptoAmount Decimal @db.Decimal(36, 18)
  fiatAmount Decimal? @db.Decimal(20, 2)
  fiatCurrency String?
  status TransactionStatus @default(PENDING)
  addressTo String?
  addressFrom String?
  description String?
  billerName String?
  billDetails Json?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@map("transactions")
}

model P2POffer {
  id String @id @default(cuid())
  traderId String
  trader User @relation(fields: [traderId], references: [id], onDelete: Cascade)
  type P2PTradeType
  cryptoSymbol String
  fiatCurrency String
  pricePerCoin Decimal @db.Decimal(24, 2)
  availableAmountMin Decimal @db.Decimal(36, 18)
  availableAmountMax Decimal @db.Decimal(36, 18)
  remainingAmount Decimal @db.Decimal(36, 18)
  limitFiatMin Decimal @db.Decimal(20, 2)
  limitFiatMax Decimal @db.Decimal(20, 2)
  paymentMethods String[]
  isOnline Boolean @default(true)
  paymentWindowMinutes Int @default(15)
  avgReleaseTimeMinutes Int @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trades P2PTrade[]
  @@index([cryptoSymbol, fiatCurrency, type])
  @@map("p2p_offers")
}

model P2PTrade {
  id String @id @default(cuid())
  offerId String
  offer P2POffer @relation(fields: [offerId], references: [id], onDelete: Restrict)
  makerId String
  maker User @relation("P2PMaker", fields: [makerId], references: [id], onDelete: Restrict)
  takerId String
  taker User @relation("P2PTaker", fields: [takerId], references: [id], onDelete: Restrict)
  type P2PTradeType
  cryptoSymbol String
  fiatCurrency String
  pricePerCoin Decimal @db.Decimal(24, 2)
  cryptoAmount Decimal @db.Decimal(36, 18)
  fiatAmount Decimal @db.Decimal(20, 2)
  paymentMethods String[]
  status P2PTradeStatus @default(AWAITING_PAYMENT)
  expiresAt DateTime
  escrowFundedAt DateTime?
  escrowReleasedAt DateTime?
  paymentMarkedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  disputedAt DateTime?
  disputeResolution P2PDisputeResolution?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([makerId, status])
  @@index([takerId, status])
  @@index([offerId, createdAt])
  @@map("p2p_trades")
}

model BillCategory {
  id String @id
  name String
  iconName String
  countries String[]
  billers Biller[]
  @@map("bill_categories")
}

model Biller {
  id String @id
  name String
  categoryId String
  category BillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  country String
  logoUrl String?
  fields Json
  fixedAmount Decimal? @db.Decimal(20, 2)
  minAmount Decimal? @db.Decimal(20, 2)
  maxAmount Decimal? @db.Decimal(20, 2)
  paymentAssetSymbols String[]
  @@index([country, categoryId])
  @@map("billers")
}

model BillPayment {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  billerId String
  idempotencyKey String
  paymentAssetSymbol String
  amountFiat Decimal @db.Decimal(20, 2)
  fiatCurrency String
  paymentAmount Decimal @db.Decimal(36, 18)
  details Json
  transactionId String? @unique
  providerReference String? @unique
  failureReason String?
  processingAt DateTime?
  completedAt DateTime?
  failedAt DateTime?
  reversedAt DateTime?
  status TransactionStatus @default(PENDING)
  webhookEvents BillWebhookEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@map("bill_payments")
}

model BillWebhookEvent {
  id String @id @default(cuid())
  eventKey String @unique
  paymentId String
  payment BillPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  providerReference String
  status String
  payloadHash String
  processedAt DateTime?
  createdAt DateTime @default(now())
  @@index([paymentId, createdAt])
  @@map("bill_webhook_events")
}

model P2PDisputeResolution {
  id String @id @default(cuid())
  tradeId String @unique
  trade P2PTrade @relation(fields: [tradeId], references: [id], onDelete: Restrict)
  resolvedById String
  resolvedBy User @relation("P2PResolver", fields: [resolvedById], references: [id], onDelete: Restrict)
  outcome String
  reason String
  createdAt DateTime @default(now())
  @@index([resolvedById, createdAt])
  @@map("p2p_dispute_resolutions")
}
